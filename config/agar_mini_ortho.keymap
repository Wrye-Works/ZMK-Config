// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.

    combos {
        compatible = "zmk,combos";

        Config-Layer {
            bindings = <&mo 4>;
            key-positions = <41 43>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base-Layer {
            display-name = "Layer 0";
            bindings = <
&kp TAB     &kp Q     &kp W  &kp E     &kp R  &kp T  &kp Y      &kp U  &kp I      &kp O       &kp P          &kp BACKSLASH     &kp BACKSPACE
&kp LCTRL   &kp A     &kp S  &kp D     &kp F  &kp G  &kp H      &kp J  &kp K      &kp L       &kp SEMICOLON  &kp SINGLE_QUOTE  &kp ENTER
&kp ESCAPE  &kp Z     &kp X  &kp C     &kp V  &kp B  &kp N      &kp M  &kp COMMA  &kp PERIOD  &kp SLASH      &kp RSHIFT        &mo 3
            &kp LALT         &kp LGUI  &mo 1         &kp SPACE         &mo 2      &kp RGUI                   &kp RALT
            >;
        };

        Number-Layer {
            bindings = <
&kp F1  &kp F2     &kp F3     &kp F4     &kp F5    &kp F6            &kp F7             &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &kp DEL
&trans  &kp N1     &kp N2     &kp N3     &kp N4    &kp N5            &kp N6             &kp N7  &kp N8  &kp N9   &kp N0   &trans   &trans
&trans  &kp MINUS  &kp EQUAL  &kp GRAVE  &kp BSLH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans  &trans  &trans   &trans   &trans   &trans
        &trans                &trans     &trans                      &trans                     &trans  &trans            &trans
            >;
        };

        Symbol-Layer {
            bindings = <
&trans  &trans           &trans       &trans     &trans      &trans          &trans           &trans         &trans        &trans                &trans                 &trans  &kp DEL
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR  &kp PERCENT     &kp LCTRL        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans
&trans  &kp UNDERSCORE   &kp PLUS     &kp TILDE  &kp PIPE    &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans         &trans        &trans                &trans                 &trans  &trans
        &trans                        &trans     &trans                      &trans                          &trans        &trans                                       &trans
            >;
        };

        Navigation-Layer {
            bindings = <
&trans  &kp C_REWIND  &kp K_MUTE            &kp C_PLAY_PAUSE      &kp C_FAST_FORWARD  &trans  &trans  &trans  &trans  &kp HOME  &kp UP_ARROW  &kp PAGE_UP    &trans
&trans  &trans        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans              &trans  &trans  &trans  &trans  &kp LEFT  &trans        &kp RIGHT      &trans
&trans  &trans        &kp C_VOL_DN          &kp C_VOLUME_UP       &trans              &trans  &trans  &trans  &trans  &kp END   &kp DOWN      &kp PAGE_DOWN  &trans
        &trans                              &trans                &trans                      &trans          &trans  &trans                  &trans
            >;
        };

        Config-Layer {
            bindings = <
&bt BT_CLR_ALL  &bt BT_PRV  &bt BT_NXT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bootloader  &sys_reset  &studio_unlock
&trans          &trans      &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans      &trans
&trans          &trans      &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans      &trans
                &trans                  &trans  &trans          &trans          &trans  &trans               &trans
            >;
        };
    };
};
